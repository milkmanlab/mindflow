{
  "name": "mindflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:webview": "vite build",
    "build:ext": "npm --prefix vscode-extension run compile",
    "build": "npm run build:webview && npm run build:ext",
    "package:ext": "npm run build && npm --prefix vscode-extension run package",
    "preview": "vite preview",
    "clean": "rimraf vscode-extension/dist vscode-extension/out dist",
    "lint": "tsc --noEmit && tsc -p e2e --noEmit && eslint src vscode-extension/src e2e playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fonts:metrics": "node scripts/generateFontMetrics.mjs",
    "demo:gif": "node scripts/recordDemoGif.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "lucide": "1.72.0",
    "lucide-react": "1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "3.0.0",
    "globals": "^17.14.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
